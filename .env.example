# Vikey (OpenAI-compatible) — https://vikey.ai
VIKEY_API_KEY=
VIKEY_BASE_URL=https://api.vikey.ai/v1

# cheap model that writes the spec, strong model that reviews the frames
BUILDER_MODEL=anthropic/claude-opus-5.5
# cheaper builders (more lint retries, plainer copy): glm/glm-5.3-flash, deepseek/deepseek-v4-flash

VERIFIER_MODEL=anthropic/claude-opus-5.5
MAX_ROUNDS=3
# stream LLM replies with live progress (flash models reason for minutes); 0 = off
LLM_STREAM=1

# optional — voice-over (TTS + word timing) and music. Without it videos render with captions + SFX only.
ELEVENLABS_API_KEY=
VOICE_ID=iWydkXKoiVtvdn4vLKp9
TTS_MODEL=eleven_v4

# optional defaults for briefs
BRAND_NAME=Vikey
BRAND_URL=vikey.ai
RENDER_CONCURRENCY=4
